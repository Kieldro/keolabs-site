---
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
import Layout from "../layouts/Layout.astro";
import demosFallback from "../data/demos.json";

// The voice demo runs in a separate repo (keolabs-voice-agent + keolabs-web-frontend).
// Keep this site loosely coupled: only the URL below ties the two together.
// Override via VOICE_DEMO_URL env var at build time.
//
// Stable Cloudflare Pages deployment. Switch to https://demo.keolabs.ai once
// the Porkbun CNAME is added (demo → keolabs-voice.pages.dev). The previous
// rotating trycloudflare.com URL invalidated user mic permission on every
// restart — the new stable origin persists the grant.
const VOICE_DEMO_URL =
  import.meta.env.VOICE_DEMO_URL ?? "https://keolabs-voice.pages.dev";

// Discover demo profiles. Prefer the sibling voice-agent repo at build
// time so adding a new client is one yaml edit; fall back to the
// checked-in `src/data/demos.json` manifest in environments where the
// voice-agent isn't available (GitHub Pages CI, fresh clone).
//
// To add a profile: add it under voice-agent/clients/<slug>/config.yaml
// AND mirror it into demos.json so the next CI build picks it up.
interface DemoProfile {
  slug: string;
  name: string;
}
function loadDemoProfiles(): DemoProfile[] {
  const clientsDir = path.resolve(process.cwd(), "../voice-agent/clients");
  if (fs.existsSync(clientsDir)) {
    const entries = fs.readdirSync(clientsDir, { withFileTypes: true });
    const profiles: DemoProfile[] = [];
    for (const e of entries) {
      if (!e.isDirectory() || e.name.startsWith("_")) continue;
      const cfgPath = path.join(clientsDir, e.name, "config.yaml");
      if (!fs.existsSync(cfgPath)) continue;
      const cfg = yaml.load(fs.readFileSync(cfgPath, "utf8")) as
        | { client_id?: string; display_name?: string }
        | null;
      if (cfg?.client_id && cfg?.display_name) {
        profiles.push({ slug: cfg.client_id, name: cfg.display_name });
      }
    }
    if (profiles.length > 0) {
      return profiles.sort((a, b) => a.name.localeCompare(b.name));
    }
  }
  return [...(demosFallback as DemoProfile[])].sort((a, b) =>
    a.name.localeCompare(b.name),
  );
}
const demoProfiles = loadDemoProfiles();
const useDropdown = demoProfiles.length > 8;

const services = [
  {
    slug: "voice",
    name: "AI phone receptionist",
    body: "24/7 AI answers your business line, books appointments, handles FAQs, transfers real emergencies. Sounds like a real person. Weekly recordings delivered.",
    for: "Dental · auto · law · home services · clinics",
  },
  {
    slug: "sms-concierge",
    name: "AI SMS concierge",
    body: "A dedicated business number with AI on the other end. Answers questions, qualifies leads, books calls, and sends proactive follow-ups — around the clock, in a voice that matches your brand.",
    for: "Service businesses · agencies · coaches · clinics",
  },
  {
    slug: "booking",
    name: "Appointment booking bot",
    body: "Inbound text → AI checks your calendar → books → confirms → sends reminders. Zero double-bookings, zero missed callbacks.",
    for: "Dentists · trainers · salons · home services",
  },
  {
    slug: "leads",
    name: "Lead qualifier",
    body: "Ads drive texts to one number. AI asks 3–5 qualifying questions, routes hot leads to sales instantly, nurtures the cold ones.",
    for: "Real estate · contractors · agencies",
  },
  {
    slug: "support",
    name: "Support triage",
    body: "AI answers FAQs from your knowledge base around the clock, escalates real edge cases to a human. Ticket volume drops 60–80%.",
    for: "SaaS · ecommerce · service shops",
  },
];

const steps = [
  {
    num: "01",
    title: "Demo",
    body: "We hop on a 20-minute call, understand your phones, and show you a live agent tuned for your business on a real number.",
  },
  {
    num: "02",
    title: "Build and go live",
    body: "We scope one automation, build it, deploy it, and run it. Month one is a build-and-tune period — full money-back on setup if it isn't right.",
  },
  {
    num: "03",
    title: "Scale what works",
    body: "Ongoing monthly retainer. We tune on real traffic, add what's working, retire what isn't. Cancel any time with 30 days notice.",
  },
];
---

<Layout>
  <div
    class="pointer-events-none fixed inset-0 -z-10 opacity-[0.04]"
    style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 48px 48px;"
  >
  </div>
  <div
    class="pointer-events-none fixed inset-0 -z-10"
    style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(239,68,68,0.12), transparent 70%);"
  >
  </div>

  <nav
    class="sticky top-0 z-50 border-b border-white/5 bg-neutral-950/70 backdrop-blur"
  >
    <div
      class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    >
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span
          class="inline-block h-2.5 w-2.5 rounded-sm bg-red-400 shadow-[0_0_12px_rgba(239,68,68,0.6)]"
        ></span>
        <span>Keo Labs</span>
      </a>
      <div class="flex items-center gap-6 text-sm text-neutral-400">
        <a href="#what" class="hidden transition hover:text-white sm:inline"
          >What we build</a
        >
        <a href="#how" class="hidden transition hover:text-white sm:inline"
          >How it works</a
        >
        <a href="#demo" class="hidden transition hover:text-white sm:inline"
          >Live demo</a
        >
        <a
          href="#contact"
          class="rounded-md border border-white/10 px-3 py-1.5 text-white transition hover:border-red-400/50 hover:bg-red-400/5"
          >Book a demo</a
        >
      </div>
    </div>
  </nav>

  <section class="relative mx-auto max-w-6xl px-6 pt-24 pb-32 sm:pt-36">
    <h1
      class="max-w-4xl text-5xl leading-[1.05] font-semibold tracking-tight text-white sm:text-7xl"
    >
      AI automation,<br />
      <span
        class="bg-gradient-to-r from-red-300 via-red-400 to-rose-400 bg-clip-text text-transparent"
        >built and installed.</span
      >
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-400 sm:text-xl">
      Stay ahead of the curve. We build and deploy AI that answers your
      customers, books your calendar, and qualifies your leads — while your
      competitors are still wondering if it works.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-medium text-neutral-950 transition hover:bg-red-300"
      >
        Book a demo
        <span
          class="transition group-hover:translate-x-0.5"
          aria-hidden="true">→</span
        >
      </a>
      <a
        href="tel:+12545365227"
        class="group inline-flex items-center gap-2 rounded-md border border-red-400/40 bg-red-400/10 px-5 py-3 text-sm font-medium text-red-200 transition hover:border-red-400/70 hover:bg-red-400/20"
      >
        Call (254) 536-5227 — hear it now
        <span
          class="transition group-hover:translate-x-0.5"
          aria-hidden="true">↗</span
        >
      </a>
      <a
        href="#demo"
        class="inline-flex items-center gap-2 rounded-md border border-white/10 px-5 py-3 text-sm font-medium text-neutral-200 transition hover:border-white/30"
      >
        Try in browser
        <span class="text-neutral-500" aria-hidden="true">↓</span>
      </a>
      <a
        href="#what"
        class="inline-flex items-center gap-2 rounded-md border border-white/10 px-5 py-3 text-sm font-medium text-neutral-200 transition hover:border-white/30"
      >
        See what we build
      </a>
    </div>

    <div
      class="mt-20 flex flex-wrap gap-x-10 gap-y-2 font-mono text-xs tracking-wide text-neutral-500 uppercase"
    >
      <span>Demo in a week</span>
      <span class="text-neutral-700">/</span>
      <span>Money-back on setup</span>
      <span class="text-neutral-700">/</span>
      <span>Built, deployed, and managed</span>
    </div>
  </section>

  <section id="what" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-14 flex items-end justify-between gap-8">
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-wider text-red-400 uppercase"
          >
            / what we build
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Five automations. Built and installed.
          </h2>
        </div>
        <p class="hidden max-w-sm text-sm text-neutral-500 sm:block">
          Every build plugs into your phone number, your calendar, and your
          tools — wired in and managed by us.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          services.map((s, i) => (
            <div class="group relative overflow-hidden rounded-xl border border-white/5 bg-white/[0.02] p-7 transition hover:border-red-400/20 hover:bg-white/[0.04]">
              <div class="mb-4 flex items-center justify-between">
                <span class="font-mono text-xs text-neutral-500">
                  0{i + 1}
                </span>
                <span class="font-mono text-xs text-neutral-600">
                  {s.slug}
                </span>
              </div>
              <h3 class="mb-2 text-xl font-semibold text-white">{s.name}</h3>
              <p class="mb-5 text-neutral-400">{s.body}</p>
              <p class="font-mono text-xs tracking-wide text-neutral-600 uppercase">
                {s.for}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-14">
        <p
          class="mb-3 font-mono text-xs tracking-wider text-red-400 uppercase"
        >
          / how it works
        </p>
        <h2
          class="max-w-2xl text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Pilot in two weeks. Scale if it works.
        </h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        {
          steps.map((step) => (
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-7">
              <div class="mb-4 font-mono text-2xl text-red-400">
                {step.num}
              </div>
              <h3 class="mb-3 text-lg font-semibold text-white">
                {step.title}
              </h3>
              <p class="text-sm leading-relaxed text-neutral-400">
                {step.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 py-24">
    <div class="mx-auto grid max-w-6xl gap-16 px-6 md:grid-cols-[1fr_2fr]">
      <div>
        <p
          class="mb-3 font-mono text-xs tracking-wider text-red-400 uppercase"
        >
          / who builds this
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Operator-built. Not a slide deck.
        </h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-neutral-400">
        <p>
          Keo Labs is a team of senior engineers who build and operate AI
          automations for small and mid-sized businesses. Production-grade
          software experience, a working AI stack already running, and a
          focus on systems that hold up under real customer traffic.
        </p>
        <p>
          We build it, we run it, we improve it. You get a working
          automation wired into your business — without the operational
          burden of managing your own AI stack.
        </p>
        <p>
          The SMBs on your block will adopt AI in the next two years. The
          ones that adopt it this year win. We're here to make sure that's
          you.
        </p>
        <p class="font-mono text-sm text-neutral-500">
          — Keo Labs · Austin, TX
        </p>
      </div>
    </div>
  </section>

  <section id="demo" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 text-center">
        <p
          class="mb-3 font-mono text-xs tracking-wider text-red-400 uppercase"
        >
          / try it live
        </p>
        <h2
          class="mb-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Hear a real voice agent — right now.
        </h2>
        <p class="mx-auto mb-8 max-w-2xl text-neutral-400">
          No signup. Two ways to try it — both live, both real.
        </p>
        <div class="mx-auto mb-2 flex max-w-2xl flex-wrap items-stretch justify-center gap-3">
          <a
            href="tel:+12545365227"
            class="group inline-flex items-center gap-2 rounded-md border border-red-400/50 bg-red-400/15 px-6 py-4 font-medium text-red-100 transition hover:border-red-400/80 hover:bg-red-400/25"
          >
            <span aria-hidden="true">📞</span>
            <span>
              <span class="block text-xs font-mono uppercase tracking-wider text-red-300/80">Call from any phone</span>
              <span class="block font-mono text-lg">+1 (254) 536-5227</span>
            </span>
          </a>
          <a
            href="#demo-launch"
            class="group inline-flex items-center gap-2 rounded-md border border-white/10 bg-white/[0.03] px-6 py-4 font-medium text-neutral-200 transition hover:border-white/20 hover:bg-white/[0.06]"
            onclick="document.getElementById('demo-launch')?.scrollIntoView({behavior:'smooth',block:'center'}); return false;"
          >
            <span aria-hidden="true">🌐</span>
            <span>
              <span class="block text-xs font-mono uppercase tracking-wider text-neutral-500">Or talk in browser</span>
              <span class="block text-lg">Click to launch ↓</span>
            </span>
          </a>
        </div>
        <p class="mt-3 text-xs text-neutral-500">
          Same agent, same stack we deploy for clients.
        </p>
      </div>

      {
        demoProfiles.length > 1 && (
          <div class="mx-auto mb-6 flex max-w-3xl items-center justify-center">
            {useDropdown ? (
              <label class="flex items-center gap-3 text-sm text-neutral-400">
                <span class="font-mono text-xs uppercase tracking-wider">
                  profile
                </span>
                <select
                  id="demo-profile-select"
                  class="rounded-md border border-white/10 bg-neutral-900 px-3 py-2 text-sm text-white focus:border-red-400 focus:outline-none"
                >
                  {demoProfiles.map((p) => (
                    <option value={p.slug}>{p.name}</option>
                  ))}
                </select>
              </label>
            ) : (
              <div
                class="flex flex-wrap justify-center gap-2"
                role="tablist"
                id="demo-profile-tabs"
              >
                {demoProfiles.map((p, i) => (
                  <button
                    type="button"
                    role="tab"
                    data-slug={p.slug}
                    aria-selected={i === 0 ? "true" : "false"}
                    class:list={[
                      "rounded-full border px-4 py-1.5 text-sm font-medium transition",
                      i === 0
                        ? "border-red-400/60 bg-red-400/10 text-red-200"
                        : "border-white/10 bg-white/[0.02] text-neutral-400 hover:border-white/20 hover:text-white",
                    ]}
                  >
                    {p.name}
                  </button>
                ))}
              </div>
            )}
          </div>
        )
      }

      <div
        class="relative mx-auto aspect-[3/4] max-w-md overflow-hidden rounded-2xl border border-white/10 bg-neutral-950 shadow-2xl sm:aspect-video sm:max-w-3xl"
      >
        <!-- Placeholder + launch button. The iframe only loads on click,
             so the demo URL is loosely coupled: if the voice agent moves or
             gets upgraded, this site doesn't break. -->
        <div
          id="demo-placeholder"
          class="absolute inset-0 flex flex-col items-center justify-center gap-5 p-6 text-center"
        >
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full border border-red-400/30 bg-red-400/10"
          >
            <svg
              class="h-8 w-8 text-red-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 18v3m0 0h3m-3 0H9m3-3a6 6 0 006-6m-12 0a6 6 0 006 6m0-15a3 3 0 00-3 3v6a3 3 0 106 0V6a3 3 0 00-3-3z"
              ></path></svg
            >
          </div>
          <p class="max-w-xs text-sm text-neutral-400">
            Loads a live voice session in this page. Mic access stays on the
            demo origin — nothing we host touches your audio.
          </p>
          <button
            id="demo-launch"
            data-demo-url={VOICE_DEMO_URL}
            data-active-slug={demoProfiles[0]?.slug ?? ""}
            class="inline-flex items-center gap-2 rounded-md bg-red-400 px-5 py-3 text-sm font-semibold text-neutral-950 transition hover:bg-red-300"
          >
            Launch demo
            <span aria-hidden="true">→</span>
          </button>
          <a
            id="demo-open-tab"
            href={VOICE_DEMO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs text-neutral-500 underline-offset-4 hover:text-neutral-300 hover:underline"
          >
            or open in a new tab ↗
          </a>
        </div>
      </div>

      <p class="mt-6 text-center font-mono text-xs text-neutral-600">
        Works best on Chrome / Safari with microphone permission granted.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const btn = document.getElementById("demo-launch");
      if (!btn) return;

      const baseUrl = btn.getAttribute("data-demo-url") || "";
      const openTab = document.getElementById("demo-open-tab");
      const container = btn.closest(".relative");

      function urlFor(slug) {
        if (!slug) return baseUrl;
        const sep = baseUrl.includes("?") ? "&" : "?";
        return baseUrl + sep + "client=" + encodeURIComponent(slug);
      }

      function setActiveSlug(slug) {
        btn.setAttribute("data-active-slug", slug || "");
        const url = urlFor(slug);
        if (openTab) openTab.setAttribute("href", url);
        // If the iframe is already loaded (user launched, then switched tabs),
        // swap its src so the new client's session connects. Without this,
        // tab clicks visually highlight but the demo persists on the original
        // client — silent UX failure.
        const iframe = container && container.querySelector("iframe");
        if (iframe) {
          iframe.src = url;
        }
      }

      // Tab strip wiring (≤8 profiles).
      const tabs = document.querySelectorAll("#demo-profile-tabs [role='tab']");
      tabs.forEach(function (t) {
        t.addEventListener("click", function () {
          tabs.forEach(function (other) {
            other.setAttribute("aria-selected", "false");
            other.classList.remove("border-red-400/60", "bg-red-400/10", "text-red-200");
            other.classList.add("border-white/10", "bg-white/[0.02]", "text-neutral-400");
          });
          t.setAttribute("aria-selected", "true");
          t.classList.remove("border-white/10", "bg-white/[0.02]", "text-neutral-400");
          t.classList.add("border-red-400/60", "bg-red-400/10", "text-red-200");
          setActiveSlug(t.getAttribute("data-slug"));
        });
      });

      // Dropdown wiring (>8 profiles).
      const sel = document.getElementById("demo-profile-select");
      if (sel) {
        setActiveSlug(sel.value);
        sel.addEventListener("change", function () {
          setActiveSlug(sel.value);
        });
      }

      function showOffline(container, url) {
        container.innerHTML =
          '<div class="flex h-full w-full flex-col items-center justify-center gap-4 p-6 text-center">' +
          '<div class="flex h-16 w-16 items-center justify-center rounded-full border border-amber-400/40 bg-amber-400/10 text-2xl">⚠️</div>' +
          '<h3 class="text-xl font-semibold text-white">Demo is temporarily offline</h3>' +
          '<p class="max-w-sm text-sm text-neutral-400">The voice agent is down for maintenance. Book a demo below and we\\\'ll send you a recording of it in action.</p>' +
          '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-neutral-500 underline-offset-4 hover:text-neutral-300 hover:underline">retry in a new tab ↗</a>' +
          "</div>";
      }

      btn.addEventListener("click", async function () {
        const slug = btn.getAttribute("data-active-slug") || "";
        const url = urlFor(slug);
        if (!url) return;
        if (!container) return;

        btn.disabled = true;
        btn.textContent = "Checking…";

        // Pre-flight: is the demo origin actually reachable? Uses no-cors
        // so cross-origin is fine — we just care that the request completes.
        let reachable = false;
        try {
          const ctl = new AbortController();
          const timer = setTimeout(() => ctl.abort(), 4000);
          await fetch(baseUrl, { mode: "no-cors", signal: ctl.signal });
          clearTimeout(timer);
          reachable = true;
        } catch (_) {
          reachable = false;
        }

        if (!reachable) {
          showOffline(container, url);
          return;
        }

        const placeholder = document.getElementById("demo-placeholder");
        if (placeholder) placeholder.remove();

        const iframe = document.createElement("iframe");
        iframe.src = url;
        iframe.title = "Keolabs voice agent demo";
        iframe.allow = "microphone; autoplay";
        iframe.setAttribute("allowfullscreen", "");
        iframe.className = "absolute inset-0 h-full w-full border-0";

        // Second guard: if the iframe never fires `load` within 10s,
        // something is wrong (CSP, X-Frame-Options, slow tunnel). Fall
        // back to the offline card.
        const loadTimeout = setTimeout(() => {
          if (!iframe.dataset.loaded) showOffline(container, url);
        }, 10000);
        iframe.addEventListener("load", () => {
          iframe.dataset.loaded = "1";
          clearTimeout(loadTimeout);
        });

        container.appendChild(iframe);
      });
    })();
  </script>

  <section id="contact" class="border-t border-white/5 py-28">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p
        class="mb-4 font-mono text-xs tracking-wider text-red-400 uppercase"
      >
        / book a demo
      </p>
      <h2
        class="mb-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        See a live agent tuned for your business.
      </h2>
      <p class="mb-10 text-lg text-neutral-400">
        Tell us what's slow in your business — we'll tell you what we'd
        automate first, then show you a working agent on a real number.
      </p>
      <a
        href="mailto:kieldro@gmail.com?subject=Pilot%20request&body=What%20I%20run%3A%0AWhat%27s%20slow%3A%0ABest%20way%20to%20reach%20me%3A"
        class="inline-flex items-center gap-2 rounded-md bg-red-400 px-6 py-3.5 text-sm font-semibold text-neutral-950 transition hover:bg-red-300"
      >
        kieldro@gmail.com
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <footer class="border-t border-white/5 py-10">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 font-mono text-xs text-neutral-600"
    >
      <span>© 2026 Keo Labs <a href="/privacy" class="text-[10px] text-neutral-800 hover:text-neutral-600">·privacy</a></span>
      <span>Stay ahead of the curve.</span>
    </div>
  </footer>
</Layout>
