---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Keo Labs — AI automation, built and installed.",
  description = "Keo Labs ships AI automations for small businesses. Appointment booking, lead qualification, support triage, and review capture — live in two weeks.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://keolabs.ai" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Display: Fraunces (variable serif, "Soft" mode for warmth + "Wonky" for character).
         Body: Geist (clean grotesk, more distinctive than Inter, kept for readability).
         Mono: JetBrains Mono — kept; we lean on it heavily for technical captions. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..900,0..100,0..1&family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-200 antialiased">
    <slot />
  </body>
</html>
